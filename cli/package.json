{
  "name": "@paveproject/infra-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive CLI to bootstrap and manage the Pave Hetzner k3s + ArgoCD cluster",
  "type": "module",
  "bin": {
    "pave-infra": "./bin/pave-infra.js"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "install-cluster": "bun run src/index.ts install",
    "status": "bun run src/index.ts status",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "execa": "^9.5.2",
    "listr2": "^8.2.5",
    "picocolors": "^1.1.1",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "typescript": "^5.7.2"
  },
  "engines": {
    "bun": ">=1.1"
  }
}
